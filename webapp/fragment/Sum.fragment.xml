<!-- No DTD or XML Schema is referenced; this is normal for SAPUI5 fragments. -->

<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" >

    <TableSelectDialog 
        id="lineSumListFragment"
        title="Sipariş Özeti"
        contentWidth="30%"
        contentHeight="20%"
        confirm="saveInput"
        cancel="handleClose"
        search=".handleSearch" 
        resizable="true"
        noDataText="Bulunamadı" 
        items="{OzetList>/results}" >  

    <columns>
        <Column 
            id="sumFrag_sumColumn0"
            visible="true"
            width="5em"
            hAlign="Center"
        >
            <Text
                text="Ürün Kodu"
                id="sumFrag_label0"
                class="smallLabel"
            />
        </Column>
        <Column
            id="sumFrag_column1"
            visible="true"
            width="8em"
            hAlign="Center"
        >
            <Text
                text="Ürün Adı"
                id="sumFrag_label1"
                class="smallLabel"
            />
        </Column> 
        <Column
            id="sumFrag_column6"
            width="4em"
        >
            <Label
                text="Alınan Sipariş Miktarı"
                id="sumFrag_label6"
                class="smallLabel"
            />
        </Column>
        
        <Column
            id="sumFrag_column8"
            width="3em"
        >
            <Label
                text="Birim"
                id="sumFrag_label8"
                class="smallLabel"
            />
        </Column>
        <Column
            id="sumFrag_column9"
            width="5em"
        >
            <Label
                text="Sipariş Tutarı"
                id="sumFrag_label9"
                class="smallLabel"
            />
        </Column> 

    </columns>

        <ColumnListItem
            id="sumFrag_IDGenColumnListItem1"
            type="Inactive"
            press=".onPress"
        > 
            <cells>
                <Text
                    text="{= parseFloat(${OzetList>Matnr}) }"
                    id="sumFrag_idMatnr"
                    visible="true"
                    class="smallLabel"
                />
                <Text
                    text="{OzetList>Maktx}"
                    id="sumFrag_idMaktx"
                    visible="true"
                    class="smallLabel"
                /> 
                <Input
                    id="sumFrag_idMenge"
                    value="{path: 'OzetList>Menge', type: '.TypeInteger', formatter: '.formatter.numberUnit'  }"
                    visible="true" 
                    editable="false"
                    required="false" 
                    valueStateText="Invalid entry"
                    class="smallLabel"
                />

                <Text
                    text="{OzetList>Meins}"
                    id="sumFrag_idMeins"
                    visible="true"
                    class="smallLabel"
                />
                <Text
                    text="{OzetList>SiparisTutar}  ₺"
                    id="sumFrag_idSiparisTutar"
                    visible="true"
                    class="smallLabel"
                /> 
            </cells>
               

        </ColumnListItem>
    </TableSelectDialog>  
</core:FragmentDefinition>
