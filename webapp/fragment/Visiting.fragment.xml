<core:FragmentDefinition xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    id="_IDFragVH">
    <Dialog id="_IDFragPayment2" title="Arama Saatlerini Düzenle" icon="sap-icon://create"
        state="Success">

