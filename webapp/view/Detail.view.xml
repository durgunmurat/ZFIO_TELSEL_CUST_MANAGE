<mvc:View xmlns:internal="sap.landvisz.internal"
    xmlns:vbm="sap.ui.vbm"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:html="http://www.w3.org/1999/xhtml"
    controllerName="zfiotelselkokpit.controller.Detail"
    xmlns:ui="sap.ui.table"
    height="100%"
>
    <Page
        id="_IDGenPage1"
        title="{i18n>SipYarat}"
    >
        <content>
            <Panel
                id="_IDGenPanel1"
                expandable="true"
                accessibleRole="Form"
                expanded="{selectionModel>/SelectionScreenPanelExpanded}"
                headerText="Genel Bilgiler"
                width="auto"
            >
                <f:SimpleForm
                    id="_IDGenSimpleForm1"
                    editable="false"
                    layout="ResponsiveGridLayout"
                    columnsXL="4"
                    columnsM="2"
                    columnsL="3"
                >
                    <f:content>
                        <core:Title
                            id="_IDGenTitle5"
                            text="Müşteri No"
                        />
                        <VBox id="_IDGenVBox11">
                            <HBox
                                id="_IDVBox0"
                                alignItems="Start"
                            >
                                <Input
                                    id="_idMusteri"
                                    value="{selectionModel>/Kunnr}"
                                    showValueHelp="true"
                                    valueHelpOnly="true"
                                    valueHelpRequest="onHelpRequestedKunnr"
                                    editable="{selectionModel>/KunnrEdit}"
                                    width="auto"
                                />
                                <Button
                                    id="_idBtnList"
                                    text="Listele"
                                    enabled="{= ${selectionModel>/AgEnabled} }"
                                    press="onPressMalzemeListesi"
                                    icon="sap-icon://display"
                                />
                            </HBox>
                            <Text id="_idTxt6" text="{selectionModel>/Name}" />
                        </VBox>
                        <core:Title
                            id="_IDGenTitle3"
                            text="Cari Hesap Bilgileri"
                        />
                        <List
                            id="_IDGenList1"
                            backgroundDesign="Transparent"
                            showSeparators="All"
                        >
                            <CustomListItem id="_idCLI1">
                                <FlexBox id="_IDGenFlexBox1">
                                    <VBox
                                        id="_IDGenVBox3"
                                        width="50%"
                                    >
                                        <HBox id="_IDGenHBox1">
                                            <Label
                                                id="_idLbl1"
                                                text="Toplam Bakiye:"
                                            />
                                        </HBox>
                                    </VBox>
                                    <VBox id="_IDGenVBox4">
                                        <HBox id="_IDGenHBox2">
                                            <ObjectNumber
                                                id="_idTxt1"
                                                number="{parts:[{path: 'selectionModel>/ToplamBakiye'},{path:'selectionModel>/Currency'}],
                                                type: 'sap.ui.model.type.Currency',
                                                formatOptions: {showMeasure: false}}"
                                            />
                                        </HBox>
                                    </VBox>
                                </FlexBox>
                            </CustomListItem>
                            <CustomListItem id="_idCLI2">
                                <FlexBox id="_IDGenFlexBox2">
                                    <VBox
                                        id="_IDGenVBox5"
                                        width="50%"
                                    >
                                        <HBox id="_IDGenHBox3">
                                            <Label
                                                id="_idLbl2"
                                                text="Email:"
                                            />
                                        </HBox>
                                    </VBox>
                                    <VBox
                                        id="_IDGenVBox6"
                                        width="50%"
                                    >
                                        <HBox id="_IDGenHBox4">
                                            <Text
                                                id="_idTxt2"
                                                text="{selectionModel>/Email}"
                                            />
                                        </HBox>
                                    </VBox>
                                </FlexBox>
                            </CustomListItem>
                            <CustomListItem id="_idCLI3">
                                <FlexBox id="_IDGenFlexBox3">
                                    <VBox
                                        id="_IDGenVBox7"
                                        width="50%"
                                    >
                                        <HBox id="_IDGenHBox5">
                                            <Label
                                                id="_idLbl3"
                                                text="Telefon:"
                                            />
                                        </HBox>
                                    </VBox>
                                    <VBox
                                        id="_IDGenVBox8"
                                        width="50%"
                                    >
                                        <HBox id="_IDGenHBox6">
                                            <Text
                                                id="_idTxt3"
                                                text="{selectionModel>/Telefon}"
                                            />
                                        </HBox>
                                    </VBox>
                                </FlexBox>
                            </CustomListItem>
                        </List>
                        <core:Title
                            id="_IDGenTitle1"
                            text="Sevkiyat Günleri"
                        />
                        <List
                            backgroundDesign="Transparent"
                            id="_IDGenList3"
                            items="{
            path: '/SevkiyatSet',
            sorter: {
                path: 'Gun'
            }
        }"
                        >
                            <items>
                                <CustomListItem id="_idCLI4">
                                    <FlexBox id="_IDGenFlexBox4">
                                        <VBox
                                            id="_IDGenVBox9"
                                            width="10%"
                                        >
                                            <HBox id="_IDGenHBox7">
                                                <core:Icon
                                                    id="_idIcon1"
                                                    src="sap-icon://inventory"
                                                />
                                            </HBox>
                                        </VBox>
                                        <VBox
                                            id="_IDGenVBox10"
                                            width="50%"
                                        >
                                            <HBox id="_IDGenHBox8">
                                                <Text
                                                    id="_idTxt5"
                                                    text="{Gun}"
                                                />
                                            </HBox>
                                        </VBox>
                                    </FlexBox>
                                </CustomListItem>
                            </items>
                        </List>
                    </f:content>
                </f:SimpleForm>
            </Panel>

            <Panel
                id="_IDGenPanel2"
                expandable="true"
                expanded="{selectionModel>/Panel1}"
                headerText="{i18n>urunListesi}"
                width="auto"
                visible="{selectionModel>/UrunPanelVisible}"
            >
                <Table
                    id="lineItemsList"
                    width="auto"
                    items="{SiparisList>/results}"
                    noDataText="{worklistView>/tableNoDataText}"
                    busyIndicatorDelay="{worklistView>/tableBusyDelay}"
                    growing="true"
                    growingThreshold="40"
                    growingScrollToLoad="false"
                    updateFinished=".onUpdateFinished"
                    fixedLayout="true"
                    showSeparators="All"
                >
                    <headerToolbar>
                        <Toolbar id="_IDGenToolbar2">
                            <Label
                                id="tableHeader"
                                text="{worklistView>/worklistTableTitle}"
                            />

                            <ToolbarSpacer id="_IDGenToolbarSpacer2" />
                            <!-- <Button
                                id="_IDBtnAra"
                                type="Accept"
                                press="onSearch3"
                                class="sapUiSmallMarginEnd"
                                icon="sap-icon://search"
                            /> -->
                            <Label
                                id="_IDLblComboBox2"
                                text="Ürün Kategorisi"
                            />
                            <ComboBox
                                selectionChange="onSearch3"
                                id="_IDGenComboBox2"
                                enabled="{= ${selectionModel>/AgEnabled} }"
                                items="{
                            path: '/UrunGrupSet',
                            sorter: { path: 'UrunGrp' }
                        }"
                            >
                                <core:Item
                                    id="_IDGenItem2"
                                    key="{UrunGrp}"
                                    text="{UrunGrpTxt}"
                                />
                            </ComboBox>
                            <SearchField
                                id="searchField"
                                width="auto"
                                placeholder="Ürün Adı veya Kodu Giriniz"
                                search=".onFilterPosts"
                                liveChange=".onSearchFieldLiveChange"
                            />
                            <Button
                                id="_IDsimulate"
                                text="Fiyat Hesapla"
                                type="Accept"
                                press="doSimulation"
                                class="sapUiSmallMarginEnd"
                                icon="sap-icon://simulate"
                            />
                        </Toolbar>
                    </headerToolbar>

                    <columns>
                        <Column
                            id="column0"
                            visible="true"
                            width="10%"
                            hAlign="Center"
                        >
                            <Text
                                text="Ürün Kodu"
                                id="label0"
                                class="smallLabel2"
                            />
                        </Column>
                        <Column
                            id="column1"
                            visible="true"
                            width="25%"
                            hAlign="Center"
                        >
                            <Text
                                text="Ürün Adı"
                                id="label1"
                                class="smallLabel2"
                            />
                        </Column>
                        <Column
                            id="column2"
                            visible="true"
                            width="10%"
                            hAlign="Center"
                        >
                            <Text
                                text="{selectionModel>/FirstDay}"
                                id="label2"
                                class="smallLabel2"
                            />
                        </Column>
                        <Column
                            id="column3"
                            visible="true"
                            width="10%"
                            hAlign="Center"
                        >
                            <Text
                                text="{selectionModel>/SecondDay}"
                                id="label3"
                                class="smallLabel2"
                            />
                        </Column>
                        <Column
                            id="column4"
                            visible="true"
                            width="10%"
                            hAlign="Center"
                        >
                            <Text
                                text="{selectionModel>/ThirdDay}"
                                id="label4"
                                class="smallLabel2"
                            />
                        </Column>
                        <Column
                            id="column5"
                            visible="true"
                            width="10%"
                            hAlign="Center"
                        >
                            <Text
                                text="Önerilen"
                                id="label5"
                                class="smallLabel2"
                            />
                        </Column>
                        <Column
                            id="column6"
                            width="15%"
                        >
                            <Label
                                text="Alınan Sipariş Miktarı"
                                id="label6"
                                class="smallLabel2"
                            />
                        </Column>
                        <Column
                            id="column7"
                            width="10%"
                        >
                            <Label
                                text="Koli İçi Adet"
                                id="label7"
                                class="smallLabel2"
                            />
                        </Column>
                        <Column
                            id="column8"
                            width="10%"
                        >
                            <Label
                                text="Birim"
                                id="label8"
                                class="smallLabel2"
                            />
                        </Column>
                        <Column
                            id="column9"
                            width="10%"
                        >
                            <Label
                                text="Sipariş Tutarı"
                                id="label9"
                                class="smallLabel2"
                            />
                        </Column>
                        <Column
                            id="column10"
                            visible="false"
                        />
                        <Column
                            id="column11"
                            visible="false"
                        >
                            <Label
                                text="Ürün Grubu"
                                id="label11"
                                class="smallLabel2"
                            />
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem
                            id="_IDGenColumnListItem1"
                            type="Inactive"
                            press=".onPress"
                        >
                            <cells>
                                <Text
                                    text="{= parseFloat(${SiparisList>Matnr}) }"
                                    id="idMatnr"
                                    visible="true"
                                    class="smallLabel2"
                                />
                                <Text
                                    text="{SiparisList>Maktx}"
                                    id="idMaktx"
                                    visible="true"
                                    class="smallLabel2"
                                />
                                <Text
                                    text="{SiparisList>FirstDayAdet}"
                                    id="idFirstDay"
                                    visible="true"
                                    class="smallLabel2"
                                />
                                <Text
                                    text="{SiparisList>SecondDayAdet}"
                                    id="idSecondDay"
                                    visible="true"
                                    class="smallLabel2"
                                />
                                <Text
                                    text="{SiparisList>ThirdDayAdet}"
                                    id="idThirdDay"
                                    visible="true"
                                    class="smallLabel2"
                                />
                                <ObjectStatus id="_IDGenObjectStatus1"
                                    class="sapUiSmallMarginBottom"
                                    text="{SiparisList>Onerilen}"
                                    state="{= ${SiparisList>Onerilen} === '0' ? 'Error' : 'Success'}"
                                />
                                <!-- <Text
                                    text="{Onerilen}"
                                    id="idOnerilen"
                                    visible="true"
                                    class="smallLabel2"
                                /> -->
                                <StepInput
                                    id="idMenge"
                                    value="{path: 'SiparisList>Menge', type: '.TypeInteger', formatter: '.formatter.numberUnit'  }"
                                    visible="true"
                                    min="0"
                                    required="false"
                                    change="onChange"
                                />
                                <Text
                                    text="{SiparisList>Koli}"
                                    id="idKoli"
                                    visible="true"
                                    class="smallLabel2"
                                />
                                <Text
                                    text="{SiparisList>Meins}"
                                    id="idMeins"
                                    visible="true"
                                    class="smallLabel2"
                                />
                                <Text
                                    text="{SiparisList>SiparisTutar}"
                                    id="idSiparisTutar"
                                    visible="true"
                                    class="smallLabel2"
                                />
                                <Text
                                    text="{SiparisList>UrunGrp}"
                                    id="idUrunGrp"
                                    visible="false"
                                    class="smallLabel2"
                                />
                                <Text
                                    text="{SiparisList>UrunGrpTxt}"
                                    id="idUrunGrpTxt"
                                    visible="false"
                                    class="smallLabel2"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table> 
            </Panel>


            <Panel
                id="_IDGenPanel4"
                expandable="true"
                expanded="{selectionModel>/Panel2}"
                headerText="Bilgiler"
                width="auto"
                visible="{selectionModel>/UrunPanelVisible}"
            >
                <Toolbar id="idBilgiToolbar">
                    <Button
                        visible="{selectionModel>/UrunPanelVisible}"
                        id="_IDTelEkle"
                        text="İletişim Bilgilerine Kişi Ekle"
                        type="Accept"
                        press="openKisiEkle"
                        class="sapUiSmallMarginEnd"
                        icon="sap-icon://phone"
                    />
                </Toolbar>
                <VBox
                    id="_IDGenVBox2"
                    class="sapUiSmallMargin"
                >
                    <f:SimpleForm
                        id="_IDGenSimpleForm2"
                        layout="ResponsiveGridLayout"
                        labelSpanXL="4"
                        labelSpanL="4"
                        labelSpanM="12"
                        labelSpanS="12"
                        adjustLabelSpan="false"
                        emptySpanXL="0"
                        emptySpanL="0"
                        emptySpanM="0"
                        emptySpanS="0"
                        columnsXL="2"
                        columnsL="2"
                        columnsM="2"
                        singleContainerFullSize="false"
                    >
                        <f:content>
                            <core:Title
                                id="_IDGenTitle2"
                                text="İletişim Bilgileri"
                            />

                            <List
                                id="_IDGenList2"
                                items="{/IletisimSet}"
                                mode="Delete"
                                delete="onKisiSil"
                            >
                                <ObjectListItem id="_IDObjectList2"
                                    title="{Name}"
                                    icon="sap-icon://call"
                                    type="Active"
                                    showMarkers="true"
                                    markFavorite="{= ${Fav} === 'X' ? true : false}"
                                    number="{Telefon}"
                                    activeIcon="sap-icon://call"
                                    press="onFavPress"> 
                                    <ObjectAttribute id="_IDGenObjectAttribute2" text="{Email}"
                                        visible="true" />
                                    <ObjectAttribute id="_IDGenObjectAttribute1" text="{Parnr}"
                                        visible="false" />
                                </ObjectListItem> 
                            </List>
                            <core:Title
                                id="_IDGenTitle4"
                                text="Notlar"
                            />
                            <Label
                                id="_IDGenLabel9"
                                text="Görüşülen Kişi"
                                labelFor="_idCBoxPerson"
                            /> 
                            <ComboBox 
                                id="_idCBoxPerson"
                                enabled="{= ${selectionModel>/AgEnabled} }"
                                items="{
                            path: '/IletisimSet',
                            sorter: { path: 'Parnr' }
                        }"
                            >
                                <core:Item
                                    id="_IDGenItem3"
                                    key="{Parnr}" 
                                    text="{Name}"
                                />
                            </ComboBox> 
                            <Label id="idLbl1"/>  
                            <TextArea id="_IDGenFeedInput1" value="" growing="true" width="100%" placeholder="Not giriniz.."/>    
                            <Label id="idLbl3"/>  
                            <Button id="idBtn1" text="Gönder" press="onSendNote" type="Accept" width="20%" /> 
                            <Label id="idLbl4"/>  
                            <Text id="idLbl2" visible="true" text="Müşterinin kanal ve operasyon yöneticilerine mail gönderilecektir."/>    
                        </f:content>
                    </f:SimpleForm>
                </VBox>
            </Panel>

            <Panel
                id="_IDGenPanel5"
                expandable="true"
                expanded="{selectionModel>/Panel3}"
                headerText="Kampanya, Lansman, Özel Ürünler"
                width="auto"
                visible="{selectionModel>/UrunPanelVisible}"
            >
                <l:VerticalLayout
                    id="_IDGenVerticalLayout1"
                    class="sapUiContentPadding"
                    width="100%"
                >
                    <l:content>
                        <List
                            id="_IDGenList4"
                            items="{/NotSet}"
                        >
                        <StandardListItem id="idStList" title="{Description}" icon="sap-icon://marketing-campaign"/>
                        </List>
                    </l:content>
                </l:VerticalLayout>
            </Panel>

            <Panel
                id="_IDGenPanel3"
                expandable="true"
                expanded="{selectionModel>/Panel4}"
                headerText="Sipariş Özeti"
                width="auto"
                visible="{selectionModel>/UrunPanelVisible}"
            >

                <Table
                    id="lineSumList"
                    width="auto"
                    items="{OzetList>/results}"
                    noDataText="{worklistView>/tableNoDataText}"
                    busyIndicatorDelay="{worklistView>/tableBusyDelay}"
                    growing="true"
                    growingScrollToLoad="false" 
                    updateFinished=".onUpdateFinished"
                    fixedLayout="true"
                    showSeparators="All"
                >
                <columns>
                    <Column
                        id="column0x"
                        visible="true"
                        width="5em"
                        hAlign="Center"
                    >
                        <Text
                            text="Ürün Kodu"
                            id="label01"
                            class="smallLabel2"
                        />
                    </Column>
                    <Column
                        id="column1x"
                        visible="true"
                        width="8em"
                        hAlign="Center"
                    >
                        <Text
                            text="Ürün Adı"
                            id="label1x"
                            class="smallLabel2"
                        />
                    </Column>
                    <Column
                        id="column6x"
                        width="4em"
                    >
                        <Label
                            text="Alınan Sipariş Miktarı"
                            id="label6x"
                            class="smallLabel2"
                        />
                    </Column>

                    <Column
                        id="column8x"
                        width="3em"
                    >
                        <Label
                            text="Birim"
                            id="label8x"
                            class="smallLabel2"
                        />
                    </Column>
                    <Column
                        id="column9x"
                        width="5em"
                    >
                        <Label
                            text="Sipariş Tutarı"
                            id="label9x"
                            class="smallLabel2"
                        />
                    </Column>

                </columns>
                    <items>
                        <ColumnListItem
                            id="_IDGenColumnListItem2"
                            type="Inactive"
                            press=".onPress"
                        >
                            <cells>
                                <Text
                                    text="{= parseFloat(${OzetList>Matnr}) }"
                                    id="idMatnrx"
                                    visible="true"
                                    class="smallLabel2"
                                />
                                <Text
                                    text="{OzetList>Maktx}"
                                    id="idMaktxx"
                                    visible="true"
                                    class="smallLabel2"
                                />
                                <Input
                                    id="idMengex"
                                    value="{path: 'OzetList>Menge', type: '.TypeInteger', formatter: '.formatter.numberUnit'  }"
                                    visible="true"
                                    editable="false"
                                    required="false"
                                    valueStateText="Invalid entry"
                                    class="smallLabel2"
                                />

                                <Text
                                    text="{OzetList>Meins}"
                                    id="idMeinsx"
                                    visible="true"
                                    class="smallLabel2"
                                />
                                <Text
                                    text="{OzetList>SiparisTutar}  ₺"
                                    id="idSiparisTutarx"
                                    visible="true"
                                    class="smallLabel2"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

                <FlexBox id="_IDGenVBox1"  
				alignItems="End" direction="Column"
				 >
                    <Label
                        id="_id21"
                        text="Toplam Sipariş Tutarı(₺)"
                        required="false"
                        width="auto"
                    />
                    <Input 
                        id="_id22"
                        value="{path: 'selectionModel>/ToplamSiparis', type: '.Currency', formatOptions:{style : 'long', showMeasure:'false' }  }"
                        enabled="false"
                        width="250px"
                    />
                    <Label 
                        id="_id23"
                        text="KDV"
                        required="false"
                        width="auto"
                    />
                    <Input 
                        id="_id24"
                        value="{path: 'selectionModel>/Kdv', type: '.Currency', formatOptions:{style : 'long', showMeasure:'false' }  }"
                        enabled="false"
                        width="250px"
                    />
                    <Label 
                        id="_id25"
                        text="KDV'li Toplam Sipariş Tutarı(₺)"
                        required="false"
                        width="auto"
                    />
                    <Input 
                        id="_id26"
                        value="{path: 'selectionModel>/ToplamSiparisKdv', type: '.Unit', formatOptions:{style : 'long', showMeasure:'false' }  }"
                        enabled="false"
                        width="250px"
                    />
                </FlexBox>
            <!-- </VBox> -->
            </Panel>
        </content>

        <footer>
            <Toolbar id="_IDGenToolbar1">
                <content>
                    <Button
                        visible="{selectionModel>/UrunPanelVisible}"
                        id="_IDGenButton5"
                        text="Siparişi Tamamla"
                        type="Accept"
                        press="saveInput"
                        class="sapUiSmallMarginEnd"
                        icon="sap-icon://cart"
                    />
                    <!-- <ToolbarSpacer id="_IDGenToolbarSpacer3" />
                    <Button
                        visible="{selectionModel>/UrunPanelVisible}"
                        id="_IDTelEkle"
                        text="İletişim Bilgilerine Kişi Ekle"
                        type="Accept"
                        press="openKisiEkle"
                        class="sapUiSmallMarginEnd"
                        icon="sap-icon://phone"
                    /> -->
                    <ToolbarSpacer id="_IDGenToolbarSpacer1" />
                    <Button
                        visible="{selectionModel>/UrunPanelVisible}"
                        id="_IDGenButton6"
                        text="Ödeme Linki Gönder"
                        type="Accept"
                        press="openPayment"
                        class="sapUiSmallMarginEnd"
                        icon="sap-icon://customer-and-supplier"
                    />
                </content>
            </Toolbar>
        </footer>
    </Page>
</mvc:View>