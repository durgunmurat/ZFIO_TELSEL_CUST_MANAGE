					<smartFilterBar:controlConfiguration> 
                        <smartFilterBar:ControlConfiguration id="_IDGenControlConfiguration3" key="UrunGrp" visibleInAdvancedArea="true" label="Ürün Grup">
		                <smartFilterBar:customControl>
                            <MultiComboBox id="multiComboBox" 
                                          selectionChange="customFieldChange"
                            items="{
                                path: '/UrunGrupSet',
                                templateShareable: true
                            }"
                        >
                            <core:Item id="_IDGenItem3" key="{UrunGrp}" text="{UrunGrpTxt}"/>
                        </MultiComboBox>
		                </smartFilterBar:customControl> 
						</smartFilterBar:ControlConfiguration>  
					</smartFilterBar:controlConfiguration> 
            </smartFilterBar:SmartFilterBar>  -->

                <Table
                    id="lineItemsList"
                    width="auto"
                    items="{/SiparisSet}"
                    noDataText="{worklistView>/tableNoDataText}"
                    busyIndicatorDelay="{worklistView>/tableBusyDelay}"
                    growing="true"
                    growingScrollToLoad="false"
                    updateFinished=".onUpdateFinished"
                    fixedLayout="true"
                    showSeparators="All"
                >
                    <headerToolbar>
                        <Toolbar id="_IDGenToolbar2">
                            <Label
                                id="tableHeader"
                                text="{worklistView>/worklistTableTitle}"
                            />

                            <ToolbarSpacer id="_IDGenToolbarSpacer2" />
                            <Button
                                id="_IDBtnAra"
                                type="Accept"
                                press="onSearch3"
                                class="sapUiSmallMarginEnd"
                                icon="sap-icon://search"
                            />
                            <Label
                                id="_IDLblComboBox2"
                                text="Ürün Kategorisi"
                            />
                            <ComboBox
                                id="_IDGenComboBox2"
                                enabled="{= ${selectionModel>/AgEnabled} }"
                                items="{
                            path: '/UrunGrupSet',
                            sorter: { path: 'UrunGrp' }
                        }"
                            >
                                <core:Item
                                    id="_IDGenItem2"
                                    key="{UrunGrp}"
                                    text="{UrunGrpTxt}"
                                />
                            </ComboBox>
                            <SearchField
                                id="searchField"
                                width="auto"
                                placeholder="Ürün Adı veya Kodu Giriniz"
                                search=".onFilterPosts"
                            />
                            <Button
                                id="_IDsimulate"
                                text="Fiyat Göster"
                                type="Accept"
                                press="doSimulation"
                                class="sapUiSmallMarginEnd"
                                icon="sap-icon://simulate"
                            />
                        </Toolbar>
                    </headerToolbar>

                    <columns>
                        <Column
                            id="column0"
                            visible="true"
                            width="10%"
                            hAlign="Center"
                        >
                            <Text
                                text="Ürün Kodu"
                                id="label0"
                                class="smallLabel"
                            />
                        </Column>
                        <Column
                            id="column1"
                            visible="true"
                            width="10%"
                            hAlign="Center"
                        >
                            <Text
                                text="Ürün Adı"
                                id="label1"
                                class="smallLabel"
                            />
                        </Column>
                        <Column
                            id="column2"
                            visible="true"
                            width="10%"
                            hAlign="Center"
                        >
                            <Text
                                text="{selectionModel>/FirstDay}"
                                id="label2"
                                class="smallLabel"
                            />
                        </Column>
                        <Column
                            id="column3"
                            visible="true"
                            width="10%"
                            hAlign="Center"
                        >
                            <Text
                                text="{selectionModel>/SecondDay}"
                                id="label3"
                                class="smallLabel"
                            />
                        </Column>
                        <Column
                            id="column4"
                            visible="true"
                            width="10%"
                            hAlign="Center"
                        >
                            <Text
                                text="{selectionModel>/ThirdDay}"
                                id="label4"
                                class="smallLabel"
                            />
                        </Column>
                        <Column
                            id="column5"
                            visible="true"
                            width="10%"
                            hAlign="Center"
                        >
                            <Text
                                text="Önerilen"
                                id="label5"
                                class="smallLabel"
                            />
                        </Column>
                        <Column
                            id="column6"
                            width="20%"
                        >
                            <Label
                                text="Alınan Sipariş Miktarı"
                                id="label6"
                                class="smallLabel"
                            />
                        </Column>
                        <Column
                            id="column7"
                            width="20%"
                        >
                            <Label
                                text="Koli İçi"
                                id="label7"
                                class="smallLabel"
                            />
                        </Column>
                        <Column
                            id="column8"
                            width="10%"
                        >
                            <Label
                                text="Birim"
                                id="label8"
                                class="smallLabel"
                            />
                        </Column>
                        <Column
                            id="column9"
                            width="20%"
                        >
                            <Label
                                text="Sipariş Tutarı"
                                id="label9"
                                class="smallLabel"
                            />
                        </Column>
                        <Column
                            id="column10"
                            visible="false"
                        />
                        <Column
                            id="column11"
                            visible="false"
                        >
                            <Label
                                text="Ürün Grubu"
                                id="label11"
                                class="smallLabel"
                            />
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem
                            id="_IDGenColumnListItem1"
                            type="Inactive"
                            press=".onPress"
                        >
                            <customData>
                                <core:CustomData
                                    key="mydata"
                                    value="{Onerilen}"
                                    writeToDom="true"
                                />
                            </customData>
                            <cells>
                                <Text
                                    text="{= parseFloat(${Matnr}) }"
                                    id="idMatnr"
                                    visible="true"
                                    class="smallLabel"
                                />
                                <Text
                                    text="{Maktx}"
                                    id="idMaktx"
                                    visible="true"
                                    class="smallLabel"
                                />
                                <Text
                                    text="{FirstDayAdet}"
                                    id="idFirstDay"
                                    visible="true"
                                    class="smallLabel"
                                />
                                <Text
                                    text="{SecondDayAdet}"
                                    id="idSecondDay"
                                    visible="true"
                                    class="smallLabel"
                                />
                                <Text
                                    text="{ThirdDayAdet}"
                                    id="idThirdDay"
                                    visible="true"
                                    class="smallLabel"
                                />
                                <Text
                                    text="{Onerilen}"
                                    id="idOnerilen"
                                    visible="true"
                                    class="smallLabel"
                                />
                                <StepInput
                                    id="idMenge"
                                    value="{path: 'Menge', type: '.TypeInteger', formatter: '.formatter.numberUnit'  }"
                                    visible="true"
                                    min="0"
                                    required="false"
                                    valueStateText="Invalid entry"
                                    class="smallLabel"
                                />
                                <Text
                                    text="{Koli}"
                                    id="idKoli"
                                    visible="true"
                                    class="smallLabel"
                                />
                                <Text
                                    text="{Meins}"
                                    id="idMeins"
                                    visible="true"
                                    class="smallLabel"
                                />
                                <Text
                                    text="{SiparisTutar}"
                                    id="idSiparisTutar"
                                    visible="true"
                                    class="smallLabel"
                                />
                                <Text
                                    text="{UrunGrp}"
                                    id="idUrunGrp"
                                    visible="false"
                                    class="smallLabel"
                                />
                                <Text
                                    text="{UrunGrpTxt}"
                                    id="idUrunGrpTxt"
                                    visible="false"
                                    class="smallLabel"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </Panel>

            <Panel
                id="_IDGenPanel4"
                expandable="true"
                expanded="{selectionModel>/Panel2}"
                headerText="Bilgiler"
                width="auto"
                visible="{selectionModel>/UrunPanelVisible}"
            >
                <Toolbar id="idBilgiToolbar">
                    <Button
                        visible="{selectionModel>/UrunPanelVisible}"
                        id="_IDTelEkle"
                        text="İletişim Bilgilerine Kişi Ekle"
                        type="Accept"
                        press="openKisiEkle"
                        class="sapUiSmallMarginEnd"
                        icon="sap-icon://phone"
                    />
                </Toolbar>
                <VBox
                    id="_IDGenVBox2"
                    class="sapUiSmallMargin"
                >
                    <f:SimpleForm
                        id="_IDGenSimpleForm2"
                        layout="ResponsiveGridLayout"
                        labelSpanXL="4"
                        labelSpanL="4"
                        labelSpanM="12"
                        labelSpanS="12"
                        adjustLabelSpan="false"
                        emptySpanXL="0"
                        emptySpanL="0"
                        emptySpanM="0"
                        emptySpanS="0"
                        columnsXL="2"
                        columnsL="2"
                        columnsM="2"
                        singleContainerFullSize="false"
                    >
                        <f:content>
                            <core:Title
                                id="_IDGenTitle2"
                                text="İletişim Bilgileri"
                            />

                            <List
                                id="_IDGenList2"
                                items="{/IletisimSet}"
                                mode="Delete"
                                delete="onKisiSil"
                            >
                                <StandardListItem
                                    id="_IDObjectList2"
                                    title="{Name}"
                                    icon="sap-icon://call"
                                    type="Active"
                                    description="{Email}"
                                    info="{Telefon}"
                                    activeIcon="sap-icon://call"
                                    press="onListItemPress"
                                />
                                <!-- <headerToolbar>
                                <Toolbar id="_IDGenToolbar3">
                                    <Button
                                        id="_IDTelEkle"
                                        text="Ekle"
                                        type="Accept"
                                        press="onKaydet"
                                        class="sapUiSmallMarginEnd"
                                        icon="sap-icon://accept"
                                    />
                                </Toolbar>
                            </headerToolbar> -->
                            </List>
                            <core:Title
                                id="_IDGenTitle4"
                                text="Notlar"
                            />
                            <Label
                                id="_IDGenLabel9"
                                text="İlgili Kişi"
                                class="sapUiSmallMarginTop sapUiTinyMarginBottom"
                            />
                            <Input id="idIlgili" />
                            <Label
                                id="_IDGenLabel10"
                                text="Geri Bildirim"
                                class="sapUiSmallMarginTop sapUiTinyMarginBottom"
                            />
                            <FeedInput
                                id="_IDGenFeedInput1"
                                post="onPost"
                                showIcon="false"
                                placeholder="Not giriniz..."
                            />
                        </f:content>
                    </f:SimpleForm>
                    <!-- <f:SimpleForm
                    id="SimpleFormDisplay480_12120-2"
                    editable="false"
                    layout="ResponsiveGridLayout"
                    labelSpanXL="4"
                    labelSpanL="4"
