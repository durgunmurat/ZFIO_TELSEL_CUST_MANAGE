                            id="_IDGenFeedInput1"
                            post="onPost"
                            showIcon="false"
                        />
                    </f:content>
                </f:SimpleForm> -->
                </VBox>
            </Panel>

            <Panel
                id="_IDGenPanel5"
                expandable="true"
                expanded="{selectionModel>/Panel3}"
                headerText="Kampanya, Lansman, Özel Ürünler"
                width="auto"
                visible="{selectionModel>/UrunPanelVisible}"
            >
                <l:VerticalLayout
                    id="_IDGenVerticalLayout1"
                    class="sapUiContentPadding"
                    width="100%"
                >
                    <l:content>
                        <List
                            id="_IDGenList4" 
                            items="{/NotSet}"
                        >
                            <FeedListItem
                                id="_IDGenFeedListItem1"
                                icon="sap-icon://accelerated"
                                iconDensityAware="true"
                                info="{Description}"
                                text="{= parseFloat(${KampanyaNo}) }" 
                            />
                        </List>
                    </l:content>
                </l:VerticalLayout>
            </Panel>

            <Panel
                id="_IDGenPanel3"
                expandable="true"
                expanded="{selectionModel>/Panel4}"
                headerText="Özet Bilgiler"
                width="auto"
                visible="{selectionModel>/UrunPanelVisible}"
            >
                <VBox id="_IDGenVBox1">
                    <Label
                        id="_id21"
                        text="Toplam Sipariş Tutarı(TRY)"
                        required="false"
                        width="auto"
                    />
                    <Input
                        id="_id22"
                        value="{path: 'selectionModel>/ToplamSiparis', type: '.Currency', formatOptions:{style : 'long', showMeasure:'false' }  }"
                        enabled="false"
                        width="500px"
                    />
                    <Label
                        id="_id23"
                        text="KDV"
                        required="false"
                        width="auto"
                    />
                    <Input
                        id="_id24"
                        value="{path: 'selectionModel>/Kdv', type: '.Currency', formatOptions:{style : 'long', showMeasure:'false' }  }"
                        enabled="false"
                        width="500px"
                    />
                    <Label
                        id="_id25"
                        text="KDV'li Toplam Sipariş Tutarı(TRY)"
                        required="false"
                        width="auto"
                    />
                    <Input
                        id="_id26"
                        value="{path: 'selectionModel>/ToplamSiparisKdv', type: '.Unit', formatOptions:{style : 'long', showMeasure:'false' }  }"
                        enabled="false"
                        width="500px"
                    />
                </VBox>
            </Panel>
        </content>

        <footer>
            <Toolbar id="_IDGenToolbar1">
                <content>
                    <Button
                        visible="{selectionModel>/UrunPanelVisible}"
                        id="_IDGenButton5"
                        text="Kaydet"
                        type="Accept"
                        press="saveInput"
                        class="sapUiSmallMarginEnd"
                        icon="sap-icon://accept"
                    />
                    <!-- <ToolbarSpacer id="_IDGenToolbarSpacer3" />
                    <Button
                        visible="{selectionModel>/UrunPanelVisible}"
                        id="_IDTelEkle"
                        text="İletişim Bilgilerine Kişi Ekle"
                        type="Accept"
                        press="openKisiEkle"
                        class="sapUiSmallMarginEnd"
                        icon="sap-icon://phone"
                    /> -->
                    <ToolbarSpacer id="_IDGenToolbarSpacer1" />
                    <Button
                        visible="{selectionModel>/UrunPanelVisible}"
                        id="_IDGenButton6"
                        text="Ödeme Linki Gönder"
                        type="Accept"
                        press="onGonder"
                        class="sapUiSmallMarginEnd"
                        icon="sap-icon://customer-and-supplier"
                    />
                </content>
            </Toolbar>
        </footer>
    </Page>
</mvc:View>
