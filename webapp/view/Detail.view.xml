                        persistencyKey="myPersKey" 
                        useToolbar="false" 
                        search=".onSearch2" 
                        >
                        <fb:filterGroupItems>
                            <fb:FilterGroupItem id="_IDGenFilterGroupItem1" name="Name" label="Ürün Kategorisi" groupName="Group1" visibleInFilterBar="true">
                                <fb:control>
                                    <MultiComboBox id="_IDGenMultiComboBox1"
                                        name="Name"
                                        selectionChange=".onSelectionChange"
                                        items="{
                                            path: '/UrunGrupSet',
                                            templateShareable: true
                                        }"
                                    >
                                        <core:Item id="_IDGenItem3" key="{UrunGrp}" text="{UrunGrpTxt}"/>
                                    </MultiComboBox>
                                </fb:control>
                            </fb:FilterGroupItem>
                            </fb:filterGroupItems>
            </fb:FilterBar> -->

                <!-- <smartFilterBar:SmartFilterBar 
            entitySet="SiparisSet"
            id="smartFilterBar" 
            useToolbar="false" 
            class="sapContrastPlus"  
            enableBasicSearch="false"
