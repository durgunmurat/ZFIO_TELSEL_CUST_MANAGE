<mvc:View
    xmlns:vbm="sap.ui.vbm"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:html="http://www.w3.org/1999/xhtml"
    controllerName="zfiotelselkokpit.controller.Detail"
    xmlns:ui="sap.ui.table"
>
    <Page
        id="_IDGenPage1"
        title="{i18n>SipYarat}"
        class="myApp"
    >
        <content>
            <Panel
                id="_IDGenPanel1"
                expandable="true"
                class="myApp"
                expanded="{selectionModel>/SelectionScreenPanelExpanded}"
                headerText="{i18n>secimKriterleri}"
                width="auto"
            >
                <VBox
                    id="_IDGenVBox0"
                    class="sapUiSmallMargin"
                >
                    <f:SimpleForm
                        id="_IDGenSimpleForm1"
                        editable="false"
                        layout="ResponsiveGridLayout"
                        columnsM="2"
                        columnsL="3"
                        columnsXL="4"
                    >
                        <f:content>
                            <core:Title
                                id="_IDGenTitle5"
                                text="Müşteri No"
                            />
                            <!-- <Label
                            id="_id5"
                            text="Müşteri No"
                            required="true"
                        /> -->
                            <VBox id="_IDVBox0">
                                <Input
                                    id="_id6"
                                    value="{selectionModel>/Kunnr}"
                                    description="{selectionModel>/Name}"
                                    showValueHelp="true"
                                    valueHelpOnly="true"
                                    valueHelpRequest="onHelpRequestedKunnr"
                                    width="auto"
                                />

                                <Button
                                    id="_idBtnList"
                                    text="Listele"
                                    enabled="{= ${selectionModel>/AgEnabled} }"
                                    press="onPressMalzemeListesi"
                                    class="sapUiSmallMarginEnd"
                                    icon="sap-icon://display"
                                />
                            </VBox>
                            <core:Title
                                id="_IDGenTitle3"
                                text="Cari Hesap Bilgileri"
                            />
                            <List id="_IDGenList1">
                                <DisplayListItem
                                    id="_IDGenDisplayListItem1"
                                    label="Toplam Bakiye"
                                    value="{selectionModel>/ToplamBakiye}"
                                />
                                <DisplayListItem
                                    id="_IDGenDisplayListItem2"
                                    label="Email"
                                    value="{selectionModel>/Email}"
                                />
                                <DisplayListItem
                                    id="_IDGenDisplayListItem3"
                                    label="Telefon"
                                    value="{selectionModel>/Telefon}"
                                />
                            </List>
                            <core:Title
                                id="_IDGenTitle1"
                                text="Sevkiyat Günleri"
                            />
                            <List
                                id="_IDGenList3"
                                items="{
            path: '/SevkiyatSet',
            sorter: {
                path: 'Gun'
            }
        }"
                            >
                                <items>
                                    <StandardListItem
                                        id="_IDGenStandardListItem1"
                                        title="{Gun}"
                                        description=""
                                        icon="sap-icon://inventory"
                                    />
                                </items>
                            </List>
                        </f:content>
                    </f:SimpleForm>
                </VBox>
            </Panel>

            <Panel
                id="_IDGenPanel2"
                expandable="true"
                expanded="{selectionModel>/Panel1}"
                headerText="{i18n>urunListesi}"
                width="auto"
                visible="{selectionModel>/UrunPanelVisible}"
            >
